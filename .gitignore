# Foundry
artifacts/
cache/
broadcast/

# Node
node_modules/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# -----------------------------------------------------------------------------
# Config privacy policy
# -----------------------------------------------------------------------------
# Real per-deployment config (deployed addresses) must not be committed
# to this repo
# Commit ONLY the schema templates (_template.json) and illustrative examples
# (*.example.json); ignore every other config/*.json (the real, per-deployment
# files named by chain alias / lane, e.g. sepolia.json, sepolia-to-fuji.json).
config/**/*.json
!config/**/_template.json
!config/**/*.example.json
# Test fixtures, not real deployments: run()-path tests need a chain file whose
# chainId (31337) matches the test EVM. They hold no addresses or operator data.
# zz-scratch-zero-salt carries the template's all-zero resolverSalt so the deploy
# guard that rejects it can be tested through run().
!config/chains/zz-scratch-ownership-factory.json
!config/chains/zz-scratch-zero-salt.json

# -----------------------------------------------------------------------------
# Generated outputs
# -----------------------------------------------------------------------------
# Test-only Safe batches. Directory rule, not a filename glob: everything else under
# out/safe/ is a committed release artifact, so a renamed test file must not slip in.
out/safe/test/
# Governance output is always run-local (snapshots hold LIVE role addresses) and is never
# committed — snapshots are promoted into config/roles/ instead. Ignore the whole tree so
# protection cannot be defeated by a rename.
out/governance/
# NOTE: real generated Safe batches under out/safe/ are intentionally NOT ignored;
# they are release artifacts reviewed and committed per deployment.
# Foundry
artifacts/
cache/
broadcast/

# Node
node_modules/

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# -----------------------------------------------------------------------------
# Config
# -----------------------------------------------------------------------------
# config/ is tracked. The one exception is test-written scratch: the suite drives the real
# deployment writer, which lands under config/deployments/.
config/deployments/zz-scratch-*.json

# -----------------------------------------------------------------------------
# Generated outputs
# -----------------------------------------------------------------------------
# Test-only Safe batches. Directory rule, not a filename glob: everything else under
# out/safe/ is a committed release artifact, so a renamed test file must not slip in.
out/safe/test/
# Governance output is run-local scratch: a snapshot is current reality, promoted into
# config/operator/ after review, so the snapshot itself never enters the tree. Ignore the
# whole directory so a rename cannot defeat the rule.
out/governance/
# NOTE: real generated Safe batches under out/safe/ are intentionally NOT ignored;
# they are release artifacts reviewed and committed per deployment.